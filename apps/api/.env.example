# AskFlow API example configuration.
# Copy to .env and adjust. Values below are the development defaults; the
# commented entries are optional and can be uncommented to override a default.
# Full documentation: docs/configuration/reference.md

# --- runtime ---
ASKFLOW_ENV=development
# APP_NAME=AskFlow
# APP_VERSION=0.1.0
# DEBUG=false
# API_PREFIX=/api/v1
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- security / access ---
SECRET_KEY=dev-secret-change-me
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# JWT_ALGORITHM=HS256
# RATE_LIMIT_PER_MINUTE=60
# TRUST_PROXY_HEADERS=0
# TRUSTED_PROXY_HOPS=1
# DISABLE_LOCAL_REGISTER=false
# ALLOW_LOCAL_REGISTER=false
# ALLOW_BOOTSTRAP_ADMIN=false
# METRICS_TOKEN=                     # required when ASKFLOW_ENV=staging|production

# --- database / cache ---
DATABASE_URL=sqlite+aiosqlite:///./askflow.dev.db
# DATABASE_URL=postgresql+asyncpg://askflow:askflow@localhost:5432/askflow
# REDIS_URL=redis://localhost:6379/0

# --- object storage (reserved) ---
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=askflow

# --- LLM (OpenAI-compatible) ---
# LLM_BASE_URL=https://api.example.com          # base URL without /v1
# LLM_API_KEY=
# LLM_MODEL_GENERATE=gpt-4o-mini
# LLM_MODEL_CLASSIFY=gpt-4o-mini
# LLM_MODEL_REWRITE=gpt-4o-mini
# LLM_MODEL_SUMMARY=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=60
# EMBEDDING_BASE_URL=                           # falls back to LLM_BASE_URL
# EMBEDDING_API_KEY=                            # falls back to LLM_API_KEY
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=384

# --- vector store (Chroma, optional) ---
# CHROMA_PERSIST_DIR=
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
# CHROMA_COLLECTION=askflow

# --- knowledge index worker ---
# INDEX_ASYNC=false
# INDEX_WORKER_ENABLED=true
# INDEX_WORKER_POLL_SECONDS=1
# INDEX_QUEUE_KEY=askflow:index_jobs
# REVISION_STORE_DIR=./data/revisions
# CANCEL_TTL_SECONDS=300
# MAX_UPLOAD_BYTES=15728640

# --- RAG / rewrite / conversation context ---
# REWRITE_SYNONYM_PATH=../../data/samples/query_synonyms.yaml
# GROUNDING_THRESHOLD=0.35
# GROUNDING_MIN_HITS=1
# GROUNDING_WEAK_SOURCES=2
# MAX_QUESTION_CHARS=2000
# MAX_ANSWER_CHARS=4000
# MAX_HISTORY_MESSAGES=20
# MAX_HISTORY_CHARS=6000
# MAX_HISTORY_MSG_CHARS=2000
# RETRIEVAL_CACHE_TTL_S=60
# RETRIEVAL_CACHE_MAX_ENTRIES=256
# HISTORY_SUMMARY_THRESHOLD=12
# HISTORY_SUMMARY_KEEP_RECENT=4
# RERANK_ENABLED=false
# RERANK_TOP_N=8

# --- agent loop budgets (legacy message/tool loop) ---
# MAX_LOOP_STEPS=6
# MAX_TOOL_CALLS=4
# MAX_WALL_MS=45000
# MAX_RETRIES_PER_TOOL=2
# MAX_SLOT_TURNS=3
# INTENT_CLARIFY_THRESHOLD=0.45
# HARNESS_POLICY_VERSION=1.0.0

# --- saved service tasks (order status) ---
# SERVICE_TASKS_ENABLED=true
# SERVICE_TASKS_GOALS=order_status
# SERVICE_TASK_POLL_SECONDS=5
# ORDER_LOOKUP_URL=
# ORDER_LOOKUP_TOKEN=

# --- handoff / sweeper / metrics ---
# HANDOFF_TIMEOUT_SECONDS=300
# SWEEPER_ENABLED=true
# SWEEPER_INTERVAL_SECONDS=60

# --- confirmation / OTP gateway ---
# GATEWAY_POLICY_VERSION=1
# CONFIRMATION_TTL_SECONDS=86400
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# ASSURANCE_TTL_SECONDS=1800

# --- intent router ---
# ROUTER_HIGH_CONFIDENCE=0.7
# ROUTER_MEDIUM_CONFIDENCE=0.45
# ROUTER_VERSION=2026.10.1
# ROUTER_TASK_SCAN_LIMIT=50

# --- outbox relay ---
# OUTBOX_RELAY_ENABLED=true
# OUTBOX_RELAY_BATCH=20
# OUTBOX_RELAY_POLL_SECONDS=2
# OUTBOX_RELAY_MAX_ATTEMPTS=5

# --- channel inbox relay / outbound ---
# CHANNEL_INBOX_RELAY_ENABLED=true
# CHANNEL_INBOX_BATCH=10
# CHANNEL_INBOX_POLL_SECONDS=2
# CHANNEL_INBOX_MAX_ATTEMPTS=5
# OUTBOUND_MAX_ATTEMPTS=3
# OUTBOUND_RETRY_BASE_SECONDS=2
# OUTBOUND_RATE_PER_MINUTE=60
# OUTBOUND_TEXT_LIMIT=4000

# --- agent memory ---
# MEMORY_EXTRACT_ENABLED=true
# MEMORY_TOP_K=5
# MEMORY_PROMPT_MAX_CHARS=400

# --- enterprise notify / OIDC / MCP ---
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_SECRET=            # falls back to SECRET_KEY
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_MOCK=false                  # forbidden in staging/production
# MCP_ENABLED=false
# MCP_TOOL_WHITELIST=search_knowledge
# SIEM_WEBHOOK_URL=

# --- Feishu channel ---
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=              # staging/production require this
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# --- WeCom / DingTalk ---
# WECOM_TOKEN=
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_CORP_SECRET=
# DINGTALK_APP_SECRET=
# DINGTALK_APP_KEY=
# DINGTALK_ROBOT_CODE=

# --- multi-bot / i18n ---
# BOT_PROFILES_JSON=
# DEFAULT_BOT_ID=default
# DEFAULT_LOCALE=zh-CN

# --- extended reasoning / sandbox (default off) ---
# REASONING_ENABLED=false
# REASONING_INTENT_WHITELIST=product_faq,troubleshoot
# REASONING_MAX_STEPS=2
# SANDBOX_ENABLED=false

# --- feature plugins ---
# ASKFLOW_PROFILE=full
# ASKFLOW_FEATURES=
