# Overlay these fields on the existing API example. Never commit real keys.
ASKFLOW_PROFILE=mall-lite
ASKFLOW_INFRA=lite
DATABASE_URL=sqlite+aiosqlite:///./data/mall.db
# DATABASE_READ_URLS=postgresql+asyncpg://user:password@replica/database
MALL_PUBLIC_REGISTER=false
MALL_DEMO_MAILBOX_ENABLED=false
INSTANCE_COUNT=1
WEB_CONCURRENCY=1
# Each port can override ASKFLOW_INFRA; leave unset to use the preset.
# CACHE_BACKEND=memory
# LOCK_BACKEND=memory
# RATE_LIMIT_BACKEND=memory
# EVENT_BUS=outbox
# SEARCH_BACKEND=sqlite_fts
# OBJECT_STORE=local
# SESSION_BACKEND=database
# FLASH_SALE_BACKEND=database
# WORKER_MODE=inprocess
NOTIFY_EMAIL=console
NOTIFY_SMS=console
MALL_WORKER_ENABLED=true
MALL_RATE_LIMIT_ENABLED=true
MALL_WORKER_POLL_SECONDS=2
MALL_EVENT_RETRY_BASE_SECONDS=2
MALL_EVENT_RETRY_MAX_SECONDS=300
LOCAL_OBJECT_DIR=./data/mall-objects
# Set independent strong secrets before staging/production; defaults are dev only.
# PAYMENT_CALLBACK_SECRET=
# MALL_TOTP_KEY=
# MALL_REFRESH_SECRET=
# ORDER_LOOKUP_TOKEN=
# Optional extras are documented in docs/mall/infra-matrix.md.
# REDIS_URL=redis://localhost:6379/0
# SEARCH_URL=http://localhost:9200
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=https://objects.example.com
# S3_BUCKET=askflow
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMS_PROVIDER_URL=
# SMS_PROVIDER_TOKEN=
# OTEL_ENABLED=false
