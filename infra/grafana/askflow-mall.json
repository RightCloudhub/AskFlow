{
  "uid": "askflow-mall",
  "title": "AskFlow 商城（未压测校准）",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["askflow", "commerce"],
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [{"name": "datasource", "type": "datasource", "query": "prometheus"}]},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "已持久化订单事件（含保留期）",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "max by(event)(askflow_mall_event_records{event=~\"mall.order.*\"})", "legendFormat": "{{event}}"}]},
    {"id": 2, "type": "timeseries", "title": "已持久化支付事件（含保留期）",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "max by(event)(askflow_mall_event_records{event=~\"mall.payment.*\"})", "legendFormat": "{{event}}"}]},
    {"id": 3, "type": "stat", "title": "负库存行 / 不平衡分录 / 对账差异",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 6},
      "targets": [{"expr": "max(askflow_mall_negative_inventory)", "legendFormat": "负库存"},
        {"expr": "max(askflow_mall_unbalanced_journals)", "legendFormat": "不平衡分录"},
        {"expr": "max(askflow_mall_reconciliation_diffs)", "legendFormat": "对账差异"}]},
    {"id": 4, "type": "timeseries", "title": "秒杀队列 / 限流",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 6},
      "targets": [{"expr": "max(askflow_mall_flash_queue_length)", "legendFormat": "待处理请求"},
        {"expr": "sum(rate(askflow_mall_rate_limit_total[5m]))", "legendFormat": "限流每秒"}]},
    {"id": 5, "type": "timeseries", "title": "缓存结果",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"x": 0, "y": 14, "w": 24, "h": 8},
      "targets": [{"expr": "sum by(result)(rate(askflow_mall_cache_total[5m]))", "legendFormat": "{{result}}"}]}
  ]
}
